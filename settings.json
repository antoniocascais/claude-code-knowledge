{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-5",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(~/Documents/claude/**)",
      "Edit(~/Documents/claude/**)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh search code:*)",
      "Bash(gitleaks:*)",
      "Bash(trivy:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(ctask:*)",
      "Skill(ctask)",
      "Bash(make:*)",
      "Skill(note-taking)",
      "Skill(daily-log)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker stats:*)",
      "Bash(docker network ls:*)",
      "Bash(docker volume ls:*)",
      "Bash(helm pull:*)",
      "Bash(helm template:*)",
      "Bash(helm dependency:*)",
      "mcp__linear-server__*"
    ],
    "deny": [
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker stop:*)",
      "Bash(docker start:*)",
      "Bash(docker rm:*)",
      "Bash(docker pull:*)",
      "Bash(docker push:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx vitest:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Task completed or input needed'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-block-sensitive-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-block-sensitive-bash.sh"
          },
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-validate-git.sh"
          },
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-validate-build.sh"
          },
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-block-absolute-paths.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-precompact-checkpoint.sh"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-precompact-daily-log-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-mark-daily-log.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-compact-reinject.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "outputStyle": "Kitty Safe",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "additionalDirectories": [
    "~/Documents/claude/",
    "/tmp"
  ],
  "feedbackSurveyState": {
    "lastShownTime": 1753975711695
  },
  "remoteControlAtStartup": false
}

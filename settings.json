{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-sonnet-4-6"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(~/Documents/claude/**)",
      "Write(~/Documents/claude/**)",
      "Edit(~/Documents/claude/**)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(gitleaks:*)",
      "Bash(trivy:*)",
      "Bash(ctask:*)",
      "Skill(ctask)",
      "Bash(make:*)",
      "Skill(note-taking)",
      "Skill(daily-log)",
      "Skill(voice-mode)",
      "Bash(~/.claude/skills/voice-mode/scripts/tts.sh:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(docker stats:*)",
      "Bash(docker network ls:*)",
      "Bash(docker volume ls:*)",
      "Bash(helm pull:*)",
      "Bash(helm template:*)",
      "Bash(helm dependency:*)"
    ],
    "deny": [
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker stop:*)",
      "Bash(docker start:*)",
      "Bash(docker rm:*)",
      "Bash(docker pull:*)",
      "Bash(docker push:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx vitest:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'export BASH_ENV=~/Documents/ai/bin/gh-function.sh' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Task completed or input needed'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-block-sensitive-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-block-sensitive-bash.sh"
          },
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-validate-git.sh"
          },
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-validate-build.sh"
          },
          {
            "type": "command",
            "command": "~/Documents/ai/bin/claude-block-absolute-paths.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Scope check: Is this edit directly addressing what was requested? Allow: bug fixes, requested changes, related config updates. Block: reformatting or refactoring outside stated scope. When uncertain, allow and trust user to correct."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "outputStyle": "Kitty Safe",
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "voiceEnabled": true,
  "additionalDirectories": [
    "~/Documents/claude/",
    "/tmp"
  ],
  "feedbackSurveyState": {
    "lastShownTime": 1753975711695
  }
}
